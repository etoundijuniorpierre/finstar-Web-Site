{
  "name": "finstar-cm",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "node --env-file-if-exists=.env scripts/generate-environment.mjs && node --env-file-if-exists=.env ./node_modules/@angular/cli/bin/ng serve",
    "build": "node --env-file-if-exists=.env scripts/generate-environment.mjs && node --env-file-if-exists=.env ./node_modules/@angular/cli/bin/ng build",
    "prerender": "node --env-file-if-exists=.env scripts/generate-environment.mjs && node --env-file-if-exists=.env ./node_modules/@angular/cli/bin/ng build --configuration production --output-mode static",
    "watch": "node --env-file-if-exists=.env scripts/generate-environment.mjs && ng build --watch --configuration development",
    "test": "node --env-file-if-exists=.env scripts/generate-environment.mjs && ng test",
    "lint:styles": "stylelint \"src/**/*.scss\"",
    "backup:directus": "node scripts/directus-backup.mjs",
    "verify:directus-backup": "node scripts/verify-directus-backup.mjs",
    "serve:ssr:FINSTAR-CM": "node --env-file-if-exists=.env scripts/serve-local.mjs",
    "check:env": "node scripts/check-build-env.mjs",
    "build:deploy": "npm run check:env && npm run build",
    "config:env": "node --env-file-if-exists=.env scripts/generate-environment.mjs",
    "decrypt:pii-backup": "node scripts/decrypt-pii-backup.mjs"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.0.3",
    "@angular/common": "^20.0.0",
    "@angular/compiler": "^20.0.0",
    "@angular/core": "^20.0.0",
    "@angular/forms": "^20.0.0",
    "@angular/platform-browser": "^20.0.0",
    "@angular/platform-server": "^20.0.0",
    "@angular/router": "^20.0.0",
    "@angular/service-worker": "^20.0.0",
    "@angular/ssr": "^20.1.3",
    "@directus/sdk": "^20.0.3",
    "@ngx-translate/core": "^17.0.0",
    "@ngx-translate/http-loader": "^17.0.0",
    "@primeuix/themes": "^1.2.3",
    "@tailwindcss/cli": "^4.1.10",
    "express": "^5.1.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "marked": "^15.0.12",
    "ngx-markdown": "^20.0.0",
    "ngx-toastr": "^19.0.0",
    "postcss": "^8.5.6",
    "primeicons": "^7.0.0",
    "primeng": "^20.0.1",
    "rxjs": "~7.8.0",
    "tailwindcss": "^4.1.11",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^20.1.3",
    "@angular/build": "^20.0.3",
    "@angular/cli": "^20.1.3",
    "@angular/compiler-cli": "^20.0.0",
    "@netlify/angular-runtime": "^4.0.0",
    "@tailwindcss/postcss": "^4.1.11",
    "@types/express": "^5.0.1",
    "@types/jasmine": "~5.1.0",
    "@types/marked": "^5.0.2",
    "@types/node": "^20.17.19",
    "autoprefixer": "^10.4.21",
    "cz-conventional-changelog": "^3.3.0",
    "jasmine-core": "~5.7.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "stylelint": "^16.26.1",
    "stylelint-config-standard-scss": "^13.1.0",
    "typescript": "~5.8.2"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}
