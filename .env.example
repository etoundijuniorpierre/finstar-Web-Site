# Variables exclusivement disponibles au processus Node SSR.
DIRECTUS_URL=https://cms.example.com
DIRECTUS_TOKEN=replace-with-a-server-only-static-token
GOATCOUNTER_TOKEN=replace-with-a-server-only-api-token
RATING_HASH_SALT=replace-with-a-long-random-secret

# Réglages EmailJS injectés dans le bundle navigateur au build (non secrets).
EMAILJS_PUBLIC_KEY=
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID_EMAIL=
EMAILJS_TEMPLATE_ID_REPLY=
# Adresses qui reçoivent les formulaires. Sans elles, contact@finstar-cm.com.
EMAILJS_CONTACT_EMAIL=contact@finstar-cm.com
EMAILJS_CAREER_EMAIL=contact@finstar-cm.com

# Mettre à true pour afficher des données de trafic simulées sur /admin.
GOATCOUNTER_MOCK_DATA=false

# Signature des liens de téléchargement des pièces jointes envoyés par e-mail.
# À défaut, DIRECTUS_TOKEN sert de clé : une rotation du jeton casse les liens déjà envoyés.
ATTACHMENT_LINK_SECRET=
# Durée de validité de ces liens, en jours (365 par défaut).
ATTACHMENT_LINK_TTL_DAYS=365
